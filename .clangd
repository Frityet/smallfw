# This file is generated by xmake. Do not edit by hand.
# Regenerate with `xmake generate-clangd` or any normal `xmake build`.

CompileFlags:
  CompilationDatabase: .
  Remove:
    - -fmodules-cache-path=*
    - -fmodule-cache-path=*
    - -fbuild-session-file=*
    - -fbuild-session-timestamp=*
    - -fmodules-validate-once-per-build-session
    - -fmodules-prune-interval=*
    - -fmodules-prune-after=*
    - -fprebuilt-module-path=*
    - -fprebuilt-implicit-modules
    - -fmodule-file=*
    - -fno-implicit-module-maps
    - -fplugin=*
    - -fpass-plugin=*
    - -load
    - -plugin
    - -plugin-arg-*
    - -fprofile-instr-generate*
    - -fprofile-instr-use=*
    - -fcoverage-mapping
  Add:
    - --target=x86_64-pc-linux-gnu
    - -std=gnu2x
    - -fmodules-cache-path=build/.clangd/clang-module-cache
    - -fno-builtin-module-map
    - -fno-modules-validate-system-headers
    - -Wno-explicit-ownership-type
    - "-D__SIZE_TYPE__=long unsigned int"
    - "-D__PTRDIFF_TYPE__=long int"
    - "-D__WCHAR_TYPE__=int"
    - "-D__WINT_TYPE__=unsigned int"
    - "-D__INT64_TYPE__=long int"
    - "-D__UINT64_TYPE__=long unsigned int"
    - "-D__INTPTR_TYPE__=long int"
    - "-D__UINTPTR_TYPE__=long unsigned int"
    - "-D__UINT64_MAX__=18446744073709551615UL"
    - "-D__UINTPTR_MAX__=18446744073709551615UL"
    - -D__ATOMIC_RELAXED=0
    - -D__ATOMIC_CONSUME=1
    - -D__ATOMIC_ACQUIRE=2
    - -D__ATOMIC_RELEASE=3
    - -D__ATOMIC_ACQ_REL=4
    - -D__ATOMIC_SEQ_CST=5
    - -D__x86_64__=1
    - -D__LP64__=1
    - -D__linux__=1
    - -D__gnu_linux__=1

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Remove:
      - "*"

---
If:
  PathMatch: .*\.(m|mm)$
CompileFlags:
  Add:
    - -D__OBJC__=1
    - -D__unsafe_unretained=

---
If:
  PathMatch: .*\.mm$
CompileFlags:
  Remove:
    - -std=gnu23
    - -std=gnu2x
  Add:
    - -x
    - objective-c++
    - -std=gnu++26

---
If:
  PathMatch: .*Runtime/src/.*\.h
CompileFlags:
  Remove:
    - -fmodules
    - -fimplicit-modules
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap

---
If:
  PathMatch: .*Runtime/src/(SmallFW|Blocks)/.*\.h
CompileFlags:
  Add:
    - -D__OBJC__=1
    - -D__unsafe_unretained=

---
If:
  PathMatch: .*Runtime/src/.*\.m
CompileFlags:
  Remove:
    - -fmodules
    - -fimplicit-modules
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap

---
If:
  PathMatch: .*StandardLibrary/src/SFStdLib/.*\.h
CompileFlags:
  Remove:
    - -fmodules
    - -fimplicit-modules
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap
  Add:
    - -D__OBJC__=1
    - -D__unsafe_unretained=

---
If:
  PathMatch: .*StandardLibrary/src/SFStdLib/.*\.m
CompileFlags:
  Remove:
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap

---
If:
  PathMatch: .*Runtime/tests/(runtime-test.*\.m|runtime-tests\.m|runtime-test-support\.h)
CompileFlags:
  Remove:
    - -fmodules
    - -fimplicit-modules
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap
  Add:
    - -DSF_CLANGD_NO_MODULES=1

---
If:
  PathMatch: .*(generic-metadata|generic-ir).*\.m
CompileFlags:
  Remove:
    - -DSF_RUNTIME_GENERIC_METADATA=0
  Add:
    - -DSF_RUNTIME_GENERIC_METADATA=1

---
If:
  PathMatch: .*StandardLibrary/tests/generic-metadata.*\.m
CompileFlags:
  Remove:
    - -fmodules
    - -fimplicit-modules
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap

---
If:
  PathMatch: .*StandardLibrary/tests/.*\.m
CompileFlags:
  Remove:
    - -fobjc-arc
  Add:
    - -fno-objc-arc

---
If:
  PathMatch: .*tools/generics-plugin/clangd-shims/.*\.h
CompileFlags:
  Remove:
    - -std=gnu23
    - -std=gnu2x
  Add:
    - -x
    - c++-header
    - -std=gnu++17

---
If:
  PathMatch: .*benchmarking/src/.*\.m
CompileFlags:
  Add:
    - -fno-implicit-module-maps

---
If:
  PathMatch: .*tools/generics-plugin/src/.*\.cpp
CompileFlags:
  Remove:
    - -std=gnu23
    - -std=gnu2x
    - -DIBOutlet=*
    - -DIBOutletCollection*
    - -DIBAction=*
    - -fobjc-runtime=*
    - -fobjc-arc
    - -fobjc-exceptions
    - -fblocks
    - -fconstant-string-class=*
    - -fmodule-map-file=Runtime/src/SFRuntime.modulemap
    - -fmodule-map-file=StandardLibrary/src/SFStdLib.modulemap
  Add:
    - -x
    - c++
    - -std=gnu++17
    - -fno-exceptions
    - -funwind-tables
    - -D_GNU_SOURCE
    - -D__STDC_CONSTANT_MACROS
    - -D__STDC_FORMAT_MACROS
    - -D__STDC_LIMIT_MACROS
    - -isystem/usr/lib/llvm-22/include
    - -isystemtools/generics-plugin/clangd-shims
